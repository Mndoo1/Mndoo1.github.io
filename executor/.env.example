# Replace BRAIN_IP with the Tailscale IP of AWS 1 (Brain server)
# Replace MONGO_USER and MONGO_PASS with the credentials set in brain/.env
MONGO_URL=mongodb://MONGO_USER:MONGO_PASS@BRAIN_IP:27017

# Replace BRAIN_IP with the Tailscale IP of AWS 1 (Brain server)
AI_ROUTER_URL=http://BRAIN_IP:4000

# Replace SCOUT_IP with the Tailscale IP of AWS 3 (Scout server)
BROWSER_WS_ENDPOINT=ws://SCOUT_IP:3000
